---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonJsonLd from "../components/jsonld/PersonJsonLd.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Skills from "../components/Skills.astro";
import PostCard from "../components/PostCard.astro";
import Contact from "../components/Contact.astro";
import { PROJECTS } from "../data/projects";
import { SITE } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <PersonJsonLd slot="head" />
  <Hero />
  <About />
  <Experience />

  <section class="section container" id="work" aria-labelledby="work-heading">
    <h2 class="label" id="work-heading">Selected Work</h2>
    <ul class="projects">
      {PROJECTS.map((project, i) => <ProjectCard project={project} index={i} />)}
    </ul>
  </section>

  <Skills />

  <section
    class="section container"
    id="writing"
    aria-labelledby="writing-heading"
  >
    <h2 class="label" id="writing-heading">Writing</h2>
    <ul class="posts">
      {posts.map((post) => <PostCard post={post} />)}
    </ul>
    <p class="all-posts">
      <a href="/blog/">All posts <span aria-hidden="true">&#8594;</span></a>
    </p>
  </section>

  <Contact />
</BaseLayout>

<style>
  .projects,
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .all-posts {
    margin-block-start: 1.5rem;
    font-family: var(--font-ui);
  }
</style>
