            <span class="chart__key"><span class="chart__swatch chart__swatch--a" aria-hidden="true"></span> Commits on <code>main</code></span>
            <span class="chart__key"><span class="chart__swatch chart__swatch--b" aria-hidden="true"></span> Pull requests opened</span>
          </div>
          <div class="chart__plot" id="plot" aria-label="Weekly commits and pull requests, 8 June to 24 August 2026">
