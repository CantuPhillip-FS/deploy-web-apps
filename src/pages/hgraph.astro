              <div class="bar bar--a" style="height:40.9%" data-target="40.9%"></div>
              <div class="bar bar--b" style="height:63.6%" data-target="63.6%"></div>
            </div>
          </div>
          <div class="week" tabindex="0" role="group" aria-label="Week of Jun 15: 10 commits, 11 pull requests">
            <span class="week__tip">Jun 15 &mdash; 10 commits &middot; 11 PRs</span>
            <div class="week__bars">
              <div class="bar bar--a" style="height:45.5%" data-target="45.5%"></div>
              <div class="bar bar--b" style="height:50.0%" data-target="50.0%"></div>
            </div>
          </div>
          <div class="week" tabindex="0" role="group" aria-label="Week of Jun 22: 11 commits, 15 pull requests">
            <span class="week__tip">Jun 22 &mdash; 11 commits &middot; 15 PRs</span>
            <div class="week__bars">
              <div class="bar bar--a" style="height:50.0%" data-target="50.0%"></div>
              <div class="bar bar--b" style="height:68.2%" data-target="68.2%"></div>
            </div>
          </div>
