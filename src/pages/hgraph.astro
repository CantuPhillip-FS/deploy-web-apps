<script is:inline>



/* One scroll-sweep engine drives the reveal, chart-grow, and count-up effects.
   Unlike IntersectionObserver, a sweep can never strand content invisible:
   anything at or above the viewport line fires, even after an anchor jump. */
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) return;

  var record = document.querySelector('.record');
  if (record) record.classList.add('is-armed');

  var jobs = [];

  document.querySelectorAll('.reveal').forEach(function (el) {
    jobs.push({ el: el, run: function () { el.classList.add('is-in'); } });
  });

  var chart = document.getElementById('chart');
  var plot = document.getElementById('plot');
  if (chart && plot) {
    var bars = Array.prototype.slice.call(plot.querySelectorAll('.bar'));
    bars.forEach(function (b) { b.style.height = '0%'; });
    jobs.push({
      el: chart,
      run: function () {
        bars.forEach(function (b, i) {
          setTimeout(function () { b.style.height = b.dataset.target; }, i * 22);
        });
      },
    });
  }

  document.querySelectorAll('[data-count]').forEach(function (el) {
    jobs.push({
      el: el,
      run: function () {
        var target = parseInt(el.dataset.count, 10);
        var final = el.textContent;
        var start = null;
        function frame(ts) {
          if (start === null) start = ts;
          var p = Math.min((ts - start) / 850, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString('en-US');
          if (p < 1) requestAnimationFrame(frame);
          else el.textContent = final;
        }
        requestAnimationFrame(frame);
      },
    });
  });

  var ticking = false;
  function sweep() {
    ticking = false;
    jobs = jobs.filter(function (j) {
      if (j.el.getBoundingClientRect().top < window.innerHeight * 0.94) {
        j.run();
        return false;
      }
      return true;
    });
    if (!jobs.length) {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }
  }
  function onScroll() {
    if (!ticking) {
      ticking = true;
      setTimeout(sweep, 40);
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  sweep();
})();

(function () {
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav__link'));
  var sections = links
    .map(function (l) { return document.querySelector(l.getAttribute('href')); })
    .filter(Boolean);
  if (!sections.length || !('IntersectionObserver' in window)) return;

  var visible = {};
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { visible[e.target.id] = e.isIntersecting ? e.intersectionRatio : 0; });
    var best = null, bestRatio = 0;
    sections.forEach(function (s) {
      var r = visible[s.id] || 0;
      if (r > bestRatio) { bestRatio = r; best = s.id; }
    });
    links.forEach(function (l) {
      l.classList.toggle('is-active', best !== null && l.getAttribute('href') === '#' + best);
    });
  }, { threshold: [0, 0.15, 0.4, 0.75], rootMargin: '-15% 0px -45% 0px' });
  sections.forEach(function (s) { obs.observe(s); });
})();

</script>

