---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SocialRail from "../components/SocialRail.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
  theme?: "light" | "dark";
}

const {
  title,
  description,
  ogImage,
  type,
  publishedTime,
  updatedTime,
  noindex,
  theme = "light",
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} | ${SITE.name}`;
const themeColor = theme === "dark" ? "#2c2b28" : undefined;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      noindex={noindex}
      themeColor={themeColor}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <SocialRail variant="rail" />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -100vw;
    top: 0;
    background: var(--color-ink);
    color: var(--color-bg);
    padding: 0.75rem 1.25rem;
    z-index: 100;
    font-family: var(--font-ui);
  }

  .skip-link:focus {
    left: 0;
  }
</style>
