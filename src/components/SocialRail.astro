---
import { SITE } from "../data/site";

interface Props {
  /** "rail" = fixed vertical rail (desktop); "row" = inline icon row (footer/mobile) */
  variant?: "rail" | "row";
}

const { variant = "rail" } = Astro.props;

const links = [
  { href: SITE.socials.github, label: "GitHub" },
  { href: SITE.socials.linkedin, label: "LinkedIn" },
  { href: SITE.socials.x, label: "X (Twitter)" },
];
---

<div class={variant === "rail" ? "rail" : "row"}>
  <ul>
    {
      links.map(({ href, label }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            <span class="visually-hidden">{label}</span>
            {label === "GitHub" && (
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a11 11 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.54-.01 2.78-.01 3.16 0 .31.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
            )}
            {label === "LinkedIn" && (
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
              </svg>
            )}
            {label === "X (Twitter)" && (
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  {
    variant === "rail" && (
      <>
        <span class="rail-line" aria-hidden="true" />
        <span class="rail-text" aria-hidden="true">
          Follow Me
        </span>
      </>
    )
  }
</div>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: var(--color-muted);
    display: block;
    padding: 0.25rem;
  }

  a:hover {
    color: var(--color-ink);
  }

  /* Inline row (footer / mobile) */
  .row ul {
    align-items: center;
  }

  /* Fixed vertical rail — desktop only */
  .rail {
    display: none;
  }

  @media (min-width: 72em) {
    .rail {
      position: fixed;
      left: clamp(1rem, 2.5vw, 2.5rem);
      bottom: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }

    .rail ul {
      flex-direction: column;
      align-items: center;
    }

    .rail-line {
      width: 1px;
      height: 3.5rem;
      background: var(--color-muted);
    }

    .rail-text {
      font-family: var(--font-ui);
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
      writing-mode: vertical-rl;
      margin-block-end: 1.5rem;
    }
  }
</style>
