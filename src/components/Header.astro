---
const { pathname } = Astro.url;
const onHome = pathname === "/";
const onGames = pathname === "/games" || pathname.startsWith("/games/");
---

<header class="header">
  <div class="container">
    <div class="bar">
      <a class="wordmark" href="/" aria-label="Phillip Cantu — home">
        <img src="/favicon.svg" alt="" width="32" height="32" />
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="/" aria-current={onHome ? "page" : undefined}>Home</a></li>
          <li>
            <a href="/games/" aria-current={onGames ? "page" : undefined}>Games</a>
          </li>
          <li>
            <a
              href="/blog/"
              aria-current={pathname.startsWith("/blog") ? "page" : undefined}
              >Blog</a
            >
          </li>
          <li><a href={onHome ? "#contact" : "/#contact"}>Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    padding-block: 1.25rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .wordmark {
    display: block;
    line-height: 0;
    flex-shrink: 0;
  }

  .wordmark img {
    border-radius: 6px;
  }

  :global(html[data-theme="dark"]) .wordmark img {
    box-shadow: 0 0 0 1px var(--color-line);
  }

  .wordmark:hover img {
    opacity: 0.8;
  }

  nav {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(0.5rem, 2.2vw, 2rem);
    padding: 0;
  }

  nav a {
    font-family: var(--font-ui);
    font-size: clamp(0.8125rem, 2.4vw, 0.9375rem);
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-ink);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
