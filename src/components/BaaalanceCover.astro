---
/** Decorative cover: BAAALANCE's cloud-with-legs sheep stacked on the plateau. */
const wool = "#F0EDE4";
const outline = "#3D423C";
---

<svg
  class="scene"
  viewBox="0 0 240 220"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect x="70" y="168" width="100" height="52" fill="#4a3d30" />
  <rect x="70" y="168" width="100" height="12" fill="#4d6a38" />
  <g fill="none" stroke="#e8e3d2" stroke-opacity=".4" stroke-width="2">
    <path d="M12 48 h24"></path>
    <path d="M4 86 h18"></path>
    <path d="M18 118 h26"></path>
    <path d="M198 56 h26"></path>
    <path d="M210 98 h20"></path>
  </g>

  <g transform="translate(78 118) scale(0.62)">
    <g stroke={outline} stroke-width="4" stroke-linejoin="round">
      <rect x="16" y="22" width="80" height="46" rx="14" fill={wool}></rect>
      <circle cx="26" cy="26" r="14" fill={wool}></circle>
      <circle cx="46" cy="18" r="15" fill={wool}></circle>
      <circle cx="67" cy="17" r="15" fill={wool}></circle>
      <circle cx="88" cy="24" r="13" fill={wool}></circle>
      <circle cx="15" cy="46" r="12" fill={wool}></circle>
      <circle cx="30" cy="66" r="10" fill={wool}></circle>
      <circle cx="54" cy="70" r="10" fill={wool}></circle>
      <circle cx="78" cy="68" r="10" fill={wool}></circle>
    </g>
    <g fill="#5A5658">
      <rect x="30" y="72" width="7" height="16" rx="2"></rect>
      <rect x="48" y="72" width="7" height="16" rx="2"></rect>
      <rect x="66" y="72" width="7" height="16" rx="2"></rect>
      <rect x="84" y="72" width="7" height="16" rx="2"></rect>
    </g>
    <g fill="#3A3A3D" stroke={outline} stroke-width="3">
      <ellipse cx="86" cy="26" rx="5" ry="6"></ellipse>
      <ellipse cx="108" cy="24" rx="5" ry="6"></ellipse>
      <ellipse cx="97" cy="38" rx="17" ry="20"></ellipse>
    </g>
    <ellipse cx="91" cy="35" rx="6" ry="8" fill="#fff"></ellipse>
    <ellipse cx="103" cy="35" rx="6" ry="8" fill="#fff"></ellipse>
    <circle cx="92.5" cy="37" r="3.6" fill="#1C1C20"></circle>
    <circle cx="104.5" cy="37" r="3.6" fill="#1C1C20"></circle>
    <circle cx="91" cy="35" r="1.2" fill="#fff"></circle>
    <circle cx="103" cy="35" r="1.2" fill="#fff"></circle>
  </g>

  <g transform="translate(70 68) scale(0.62)">
    <g stroke={outline} stroke-width="4" stroke-linejoin="round">
      <rect x="16" y="22" width="80" height="46" rx="14" fill={wool}></rect>
      <circle cx="26" cy="26" r="14" fill={wool}></circle>
      <circle cx="46" cy="18" r="15" fill={wool}></circle>
      <circle cx="67" cy="17" r="15" fill={wool}></circle>
      <circle cx="88" cy="24" r="13" fill={wool}></circle>
      <circle cx="15" cy="46" r="12" fill={wool}></circle>
      <circle cx="30" cy="66" r="10" fill={wool}></circle>
      <circle cx="54" cy="70" r="10" fill={wool}></circle>
      <circle cx="78" cy="68" r="10" fill={wool}></circle>
    </g>
    <g fill="#5A5658">
      <rect x="30" y="72" width="7" height="16" rx="2"></rect>
      <rect x="48" y="72" width="7" height="16" rx="2"></rect>
      <rect x="66" y="72" width="7" height="16" rx="2"></rect>
      <rect x="84" y="72" width="7" height="16" rx="2"></rect>
    </g>
    <g fill="#3A3A3D" stroke={outline} stroke-width="3">
      <ellipse cx="86" cy="26" rx="5" ry="6"></ellipse>
      <ellipse cx="108" cy="24" rx="5" ry="6"></ellipse>
      <ellipse cx="97" cy="38" rx="17" ry="20"></ellipse>
    </g>
    <ellipse cx="91" cy="35" rx="6" ry="8" fill="#fff"></ellipse>
    <ellipse cx="103" cy="35" rx="6" ry="8" fill="#fff"></ellipse>
    <circle cx="92.5" cy="37" r="3.6" fill="#1C1C20"></circle>
    <circle cx="104.5" cy="37" r="3.6" fill="#1C1C20"></circle>
    <circle cx="91" cy="35" r="1.2" fill="#fff"></circle>
    <circle cx="103" cy="35" r="1.2" fill="#fff"></circle>
  </g>

  <g transform="translate(84 18) scale(0.62)">
    <g stroke={outline} stroke-width="4" stroke-linejoin="round">
      <rect x="16" y="22" width="80" height="46" rx="14" fill={wool}></rect>
      <circle cx="26" cy="26" r="14" fill={wool}></circle>
      <circle cx="46" cy="18" r="15" fill={wool}></circle>
      <circle cx="67" cy="17" r="15" fill={wool}></circle>
      <circle cx="88" cy="24" r="13" fill={wool}></circle>
      <circle cx="15" cy="46" r="12" fill={wool}></circle>
      <circle cx="30" cy="66" r="10" fill={wool}></circle>
      <circle cx="54" cy="70" r="10" fill={wool}></circle>
      <circle cx="78" cy="68" r="10" fill={wool}></circle>
    </g>
    <g fill="#5A5658">
      <rect x="30" y="72" width="7" height="16" rx="2"></rect>
      <rect x="48" y="72" width="7" height="16" rx="2"></rect>
      <rect x="66" y="72" width="7" height="16" rx="2"></rect>
      <rect x="84" y="72" width="7" height="16" rx="2"></rect>
    </g>
    <g fill="#3A3A3D" stroke={outline} stroke-width="3">
      <ellipse cx="86" cy="26" rx="5" ry="6"></ellipse>
      <ellipse cx="108" cy="24" rx="5" ry="6"></ellipse>
      <ellipse cx="97" cy="38" rx="17" ry="20"></ellipse>
    </g>
    <ellipse cx="91" cy="34" rx="7" ry="9" fill="#fff"></ellipse>
    <ellipse cx="103" cy="34" rx="7" ry="9" fill="#fff"></ellipse>
    <circle cx="92" cy="36" r="2" fill="#1C1C20"></circle>
    <circle cx="104" cy="36" r="2" fill="#1C1C20"></circle>
    <ellipse cx="97" cy="50" rx="3" ry="4" fill="#1C1C20"></ellipse>
  </g>
</svg>

<style>
  .scene {
    width: 100%;
    height: 100%;
  }
</style>
