---
import { SITE } from "../data/site";
---

<section class="section container" id="contact" aria-labelledby="contact-heading">
  <h2 class="label" id="contact-heading">Contact</h2>
  <div class="grid">
    <div class="pitch">
      <p class="big">Let's build something.</p>
      <p class="sub">
        Open to web app based software engineering roles — remote. The fastest
        way to reach me is email; I read everything and reply quickly.
      </p>
    </div>
    <div class="reach">
      <a class="pill email" href={`mailto:${SITE.email}`}>
        {SITE.email} <span aria-hidden="true">&#8599;</span>
      </a>
      <p class="alt">
        Or find me on <a
          href={SITE.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >.
      </p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
  }

  .big {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-block-end: 1rem;
  }

  .sub {
    color: var(--color-muted);
    max-width: 40ch;
  }

  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .email {
    font-size: clamp(1.0625rem, 2.5vw, 1.25rem);
    padding: 0.9em 1.5em;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .alt {
    font-family: var(--font-ui);
    color: var(--color-muted);
  }

  .alt a {
    color: var(--color-ink);
  }

  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .reach {
      justify-self: end;
      align-items: flex-end;
    }
  }
</style>
